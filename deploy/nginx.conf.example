server {
    listen 443 ssl http2;
    server_name dukame.example.com;
    root /var/www/dukame/public;
    index index.php;

    ssl_certificate /etc/letsencrypt/live/dukame.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dukame.example.com/privkey.pem;

    location /assets/ { try_files $uri =404; expires 7d; add_header Cache-Control "public, max-age=604800, stale-while-revalidate=86400"; }
    location /uploads/ { try_files $uri =404; }
    location / { try_files $uri $uri/ /router.php?$query_string; }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
    }

    location ~* /(\.env|composer\.(json|lock)|README\.md|ARCHITECTURE\.md|PHASE_.*\.md)$ { deny all; }
}
