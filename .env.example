APP_NAME=Dukame
APP_TAGLINE=A simpler way to sell online
APP_PRIMARY_COLOR=#5B21B6
APP_ACCENT_COLOR=#F59E0B
APP_ENV=local
APP_DEBUG=true
# Generate with: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Nairobi

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dukame
DB_USERNAME=root
DB_PASSWORD=

SESSION_NAME=dukame_session

# TextSMS platform credentials (configure once for Dukame, not per merchant)
TEXTSMS_ENABLED=false
TEXTSMS_API_URL=https://sms.textsms.co.ke/api/services/sendsms/
TEXTSMS_API_KEY=
TEXTSMS_PARTNER_ID=
TEXTSMS_SENDER_ID=Dukame

# Dukame platform subscription billing (merchant -> Dukame). Keep these separate from shop M-Pesa credentials.
SUBSCRIPTION_MPESA_ENABLED=false
SUBSCRIPTION_MPESA_ENVIRONMENT=sandbox
SUBSCRIPTION_MPESA_SHORTCODE=
SUBSCRIPTION_MPESA_CONSUMER_KEY=
SUBSCRIPTION_MPESA_CONSUMER_SECRET=
SUBSCRIPTION_MPESA_PASSKEY=
SUBSCRIPTION_MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
SUBSCRIPTION_MPESA_PARTY_B=

# Platform administration. This is intentionally separate from merchant users.
# Change this to a non-obvious path before production deployment.
ADMIN_LINK=platform

# Phase 7 security controls
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW=900
API_LOGIN_RATE_LIMIT_MAX=10
API_LOGIN_RATE_LIMIT_WINDOW=900
API_MAX_BODY_BYTES=2097152

PUBLIC_ORDER_RATE_LIMIT_MAX=30
PUBLIC_ORDER_RATE_LIMIT_WINDOW=600
PUBLIC_TRACK_RATE_LIMIT_MAX=30
PUBLIC_TRACK_RATE_LIMIT_WINDOW=600
PUBLIC_PAYMENT_RATE_LIMIT_MAX=20
PUBLIC_PAYMENT_RATE_LIMIT_WINDOW=600
PUBLIC_PAYMENT_RETRY_RATE_LIMIT_MAX=5
PUBLIC_PAYMENT_RETRY_RATE_LIMIT_WINDOW=900
SUBSCRIPTION_STK_RATE_LIMIT_MAX=5
SUBSCRIPTION_STK_RATE_LIMIT_WINDOW=900
