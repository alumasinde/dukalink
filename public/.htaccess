RewriteEngine On

# Platform administration. The dispatcher validates the requested link against ADMIN_LINK from .env.
# This keeps /admin/login invalid even if someone guesses the old path.
RewriteRule ^([a-zA-Z0-9_-]+)/(login|logout|dashboard|plans)/?$ platform/dispatcher.php?admin_link=$1&action=$2 [L,QSA]

# Dynamic SEO endpoints
RewriteRule ^robots\.txt$ seo/robots.php [L,QSA]
RewriteRule ^sitemap\.xml$ seo/sitemap.php [L,QSA]

# Dukame API v1
RewriteRule ^api/v1(?:/.*)?$ api.php [L,QSA]

# Clean application routes
RewriteRule ^$ index.php [L,QSA]
RewriteRule ^login/?$ login.php [L,QSA]
RewriteRule ^logout/?$ logout.php [L,QSA]
RewriteRule ^register/?$ register.php [L,QSA]
RewriteRule ^onboarding/?$ onboarding.php [L,QSA]
RewriteRule ^onboarding/complete/?$ onboarding-complete.php [L,QSA]

RewriteRule ^dashboard/?$ dashboard/index.php [L,QSA]
RewriteRule ^products/?$ products/index.php [L,QSA]
RewriteRule ^products/create/?$ products/create.php [L,QSA]
RewriteRule ^products/edit/?$ products/edit.php [L,QSA]
RewriteRule ^categories/?$ categories/index.php [L,QSA]
RewriteRule ^orders/?$ orders/index.php [L,QSA]
RewriteRule ^orders/view/?$ orders/view.php [L,QSA]
RewriteRule ^customers/?$ customers/index.php [L,QSA]
RewriteRule ^customers/view/?$ customers/view.php [L,QSA]
RewriteRule ^settings/?$ settings/index.php [L,QSA]
RewriteRule ^settings/shop/?$ settings/shop.php [L,QSA]
RewriteRule ^settings/payments/?$ settings/payments.php [L,QSA]
RewriteRule ^settings/delivery/?$ settings/delivery.php [L,QSA]
RewriteRule ^settings/notifications/?$ settings/notifications.php [L,QSA]
RewriteRule ^cart/?$ cart/index.php [L,QSA]
RewriteRule ^checkout/?$ checkout/index.php [L,QSA]
RewriteRule ^track/?$ track/index.php [L,QSA]

# Static files/directories not handled by the application routes above.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Legacy storefront URL -> short storefront URL
RewriteRule ^shop/([a-z0-9]+(?:-[a-z0-9]+)*)/?$ /$1 [R=301,L,NE,NC]

# Public product page: /merchant-slug/product/product-slug
RewriteRule ^([a-z0-9]+(?:-[a-z0-9]+)*)/product/([a-z0-9]+(?:-[a-z0-9]+)*)/?$ shop/product.php?slug=$1&product=$2 [L,QSA,NC]

# Public merchant storefront: /merchant-slug
RewriteRule ^([a-z0-9]+(?:-[a-z0-9]+)*)/?$ shop/index.php?slug=$1 [L,QSA,NC]

# Static files (CSS, JS, images, uploads) are served directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
