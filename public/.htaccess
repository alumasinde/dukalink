Options -Indexes
RewriteEngine On

# Never expose deployment/configuration/source artifacts.
<FilesMatch "^(\.env|composer\.(json|lock)|README\.md|ARCHITECTURE\.md|PHASE_.*\.md)$">
    Require all denied
</FilesMatch>

# Serve existing files/directories directly (assets, uploads, favicon, etc.).
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Send every application request through the single PHP router.
RewriteRule ^ router.php [L,QSA]

# Long-lived caching for fingerprinted/static assets.
<FilesMatch "\.(?:css|js|webp|png|jpe?g|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
</FilesMatch>
