RewriteEngine On

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^api/v1(?:/.*)?$ api.php [L,QSA]

RewriteRule ^$ index.php [L]
RewriteRule ^login/?$ login.php [L,QSA]
RewriteRule ^logout/?$ logout.php [L,QSA]
RewriteRule ^register/?$ register.php [L,QSA]
RewriteRule ^onboarding/?$ onboarding.php [L,QSA]
RewriteRule ^onboarding/complete/?$ onboarding-complete.php [L,QSA]
RewriteRule ^dashboard/?$ dashboard/index.php [L,QSA]
RewriteRule ^products/?$ products/index.php [L,QSA]
RewriteRule ^products/create/?$ products/create.php [L,QSA]
RewriteRule ^products/edit/?$ products/edit.php [L,QSA]
RewriteRule ^categories/?$ categories/index.php [L,QSA]
RewriteRule ^orders/?$ orders/index.php [L,QSA]
RewriteRule ^orders/view/?$ orders/view.php [L,QSA]
RewriteRule ^customers/?$ customers/index.php [L,QSA]
RewriteRule ^customers/view/?$ customers/view.php [L,QSA]
RewriteRule ^settings/?$ settings/index.php [L,QSA]
RewriteRule ^settings/shop/?$ settings/shop.php [L,QSA]
RewriteRule ^cart/?$ cart/index.php [L,QSA]
RewriteRule ^checkout/?$ checkout/index.php [L,QSA]
RewriteRule ^track/?$ track/index.php [L,QSA]
RewriteRule ^([a-z0-9]+(?:-[a-z0-9]+)*)/product/([a-z0-9]+(?:-[a-z0-9]+)*)/?$ shop/product.php?slug=$1&product=$2 [L,QSA]

RewriteRule ^shop/([a-z0-9]+(?:-[a-z0-9]+)*)/?$ /$1 [R=301,L,NE]
RewriteRule ^([a-z0-9]+(?:-[a-z0-9]+)*)/?$ shop/index.php?slug=$1 [L,QSA]
